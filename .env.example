# ── ブラウザにも公開される値（NEXT_PUBLIC_） ─────────────────────
# Supabase プロジェクトのURL（ローカル: http://127.0.0.1:54321）
NEXT_PUBLIC_SUPABASE_URL=
# publishable key（sb_publishable_...）または従来の anon key（RLSで守られるので公開してよい）
# 名前は NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY のどちらでもよい
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── サーバー専用（絶対に NEXT_PUBLIC_ を付けない） ─────────────────
# サーバーからの書き込みは service role キーではなく、この直接接続（postgres ロール）で行う。
# RLS を通らないので、この値は絶対にクライアントへ渡さないこと
# Postgres への直接接続。Vercel では Supabase の接続プール（Transaction mode, 6543番）を使う
# 例: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# ローカル: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
